 "sizes": []}, "css_classes": "rbo-single-sidebar"}, "elements": [{"id": "eb27dd7", "elType": "widget", "settings": {"html": "<style>\n.rbo-side{font-family:'Cairo','Tajawal',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:#1d2430;direction:rtl;text-align:right}\n.rbo-side-card{background:#fff;border:1px solid #e6e8ee;border-radius:12px;padding:22px 20px;margin:0 0 18px;text-align:right}\n.rbo-side-card h3{margin:0 0 10px;font-family:'Cairo','Tajawal',sans-serif;font-size:21px;font-weight:700;color:#09203B;line-height:1.35}\n.rbo-side-card p{margin:0 0 14px;font-size:14.5px;line-height:1.65;color:#445066}\n.rbo-side-card ul{list-style:none;margin:0;padding:0}\n.rbo-side-card li{margin:0;padding:10px 0;border-top:1px solid #eef0f4}\n.rbo-side-card li:first-child{border-top:0;padding-top:0}\n.rbo-side-card a{color:#09203B;text-decoration:none;font-weight:600;font-size:14.5px;line-height:1.5}\n.rbo-side-card a:hover{color:#C9A227}\n.rbo-side-cta{background:#09203B;color:#fff;border:none}\n.rbo-side-cta h3,.rbo-side-cta p{color:#fff}\n.rbo-side-cta p{opacity:.92}\n.rbo-side-btn{display:inline-block;background:#E8B84B;color:#09203B!important;font-weight:700;padding:12px 18px;border-radius:8px;text-decoration:none}\n.rbo-side-btn:hover{background:#f0c85c;color:#09203B!important}\n.rbo-side-note{font-size:13px;opacity:.85;margin-top:12px;direction:ltr;text-align:right}\n</style>\n<div class=\"rbo-side\" dir=\"rtl\">\n  <div class=\"rbo-side-card rbo-side-cta\">\n    <h3>هل تحتاج مساعدة في ضرائب الإمارات؟</h3>\n    <p>وكلاء ضريبيون ومحاسبون معتمدون من الهيئة الاتحادية للضرائب (FTA) لضريبة القيمة المضافة وضريبة الشركات ومسك الدفاتر والتدقيق المالي — إجابات واضحة خلال 10 دقائق.</p>\n    <a class=\"rbo-side-btn\" href=\"/ar/contact-us-2/\">احجز استشارة مجانية الآن</a>\n    <p class=\"rbo-side-note\">واتساب: +971 50 805 1857</p>\n  </div>\n  <div class=\"rbo-side-card\">\n    <h3>أبرز الخدمات المحاسبية والضريبية</h3>\n    <ul>\n      <li><a href=\"/ar/vat-registration-filing/\">تسجيل وإقرارات ضريبة القيمة المضافة</a></li>\n      <li><a href=\"/ar/corporate-tax/\">ضريبة الشركات في الإمارات (9%)</a></li>\n      <li><a href=\"/ar/bookkeeping-and-accounting/\">مسك الدفاتر والمحاسبة</a></li>\n      <li><a href=\"/ar/audit-assurance/\">التدقيق المالي المعتمد</a></li>\n      <li><a href=\"/ar/payroll/\">إدارة الرواتب ونظام WPS</a></li>\n      <li><a href=\"/ar/virtual-cfo/\">المدير المالي الافتراضي (CFO)</a></li>\n    </ul>\n  </div>\n  <div class=\"rbo-side-card\">\n    <h3>روابط سريعة</h3>\n    <ul>\n      <li><a href=\"/ar/blog-2/\">جميع مقالات المدونة</a></li>\n      <li><a href=\"/ar/areas-we-serve-2/dubai/\">مكتب محاسبة في دبي</a></li>\n      <li><a href=\"/ar/about-us-2/\">من نحن — عن RBO</a></li>\n      <li><a href=\"/ar/contact-us-2/\">تواصل معنا</a></li>\n    </ul>\n  </div>\n</div>"}, "elements": [], "widgetType": "html"}], "isInner": true}], "isInner": false}]